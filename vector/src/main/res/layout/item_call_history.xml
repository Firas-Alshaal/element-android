<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/call_history_item_background"
    android:padding="16dp"
    android:elevation="4dp">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/avatarImageView"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/background_circle"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:src="@sample/room_round_avatars" />

    <!-- Group Indicator -->
    <ImageView
        android:id="@+id/groupIndicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_public_room"
        android:background="@drawable/background_circle"
        android:backgroundTint="@color/element_accent_light"
        android:padding="2dp"
        app:tint="@android:color/white"
        app:layout_constraintCircle="@id/avatarImageView"
        app:layout_constraintCircleAngle="135"
        app:layout_constraintCircleRadius="26dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Room Name -->
    <TextView
        android:id="@+id/roomNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/avatarImageView"
        app:layout_constraintTop_toTopOf="@id/avatarImageView"
        app:layout_constraintEnd_toStartOf="@id/timestampText"
        app:layout_constraintHorizontal_bias="0"
        tools:text="Ahmad Ali" />

    <!-- Call Direction and Type -->
    <TextView
        android:id="@+id/callDirectionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:layout_marginStart="16dp"
        android:alpha="0.8"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/avatarImageView"
        app:layout_constraintTop_toBottomOf="@id/roomNameText"
        app:layout_constraintEnd_toStartOf="@id/callTypeIcon"
        app:layout_constraintHorizontal_bias="0"
        tools:text="Outgoing voice call" />

    <!-- Duration -->
    <TextView
        android:id="@+id/durationText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:alpha="0.6"
        android:ellipsize="end"
        android:layout_marginStart="16dp"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/avatarImageView"
        app:layout_constraintTop_toBottomOf="@id/callDirectionText"
        app:layout_constraintEnd_toStartOf="@id/callTypeIcon"
        app:layout_constraintBottom_toBottomOf="@id/avatarImageView"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintVertical_bias="0"
        tools:text="Duration: 2:30" />

    <!-- Timestamp -->
    <TextView
        android:id="@+id/timestampText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:fontFamily="sans-serif-medium"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/roomNameText"
        tools:text="2h ago" />

    <!-- Call Type Icon -->
    <ImageView
        android:id="@+id/callTypeIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="8dp"
        android:padding="2dp"
        app:layout_constraintBottom_toBottomOf="@id/avatarImageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timestampText"
        app:layout_constraintVertical_bias="1.0"
        tools:src="@drawable/ic_phone"
        tools:tint="@android:color/holo_green_dark" />

</androidx.constraintlayout.widget.ConstraintLayout>
