<?xml version="1.0" encoding="utf-8"?><!-- The android:opacity=”opaque” line — this is critical in preventing a flash of black as your theme transitions. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">

    <!-- Background color -->
    <item android:drawable="?colorBackgroundFloating" />

    <!-- Centered logo -->
    <item
        android:drawable="@drawable/element_logo_green"
        android:gravity="center" />

</layer-list>
